{
  "name": "intelium-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/postbuild.mjs",
    "lint": "eslint",
    "package": "next build && rm -f intelium-site.zip && cd out && zip -qr ../intelium-site.zip . -x \".DS_Store\"",
    "preview": "npx --yes serve out -l 4173",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "sync-site": "node scripts/sync-site.mjs",
    "publicar:teste": "bash scripts/publicar.sh teste",
    "publicar:prd": "bash scripts/publicar.sh prd",
    "publicar:sync": "bash scripts/publicar.sh sync"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "typescript": "^5"
  }
}
