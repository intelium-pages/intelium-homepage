.7, 0.2, 1) 0.15s 1 normal both running rise;\">Vortexa: 15% fewer Kafka management hours and deploys in minutes</h1><p data-dc-tpl=\"38\" style=\"margin: 0px; font-size: clamp(16px, 1.6vw, 18px); line-height: 1.6; max-width: 720px; color: var(--color-neutral-200); animation: 1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.3s 1 normal both running rise;\">How an energy analytics company gained visibility over its real-time data flows with Lenses on Amazon MSK.</p></div></header><article data-dc-tpl=\"39\" style=\"max-width: 1200px; margin: 0px auto; padding: 0px clamp(20px, 5vw, 72px) clamp(64px, 8vw, 104px); display: flex; flex-direction: column; gap: 40px;\"><div data-dc-tpl=\"40\" style=\"position: relative; width: 100%; max-width: 880px; aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); background: var(--color-neutral-800);\"><svg viewBox=\"0 0 400 225\" width=\"100%\" aria-hidden=\"true\" style=\"position: absolute; inset: 0px; display: block; width: 100%; height: 100%;\"><defs><linearGradient id=\"bglenses\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0\" stop-color=\"var(--color-accent-900)\"></stop><stop offset=\"1\" stop-color=\"var(--color-neutral-800)\"></stop></linearGradient><radialGradient id=\"gllenses\"><stop offset=\"0\" stop-color=\"var(--color-accent-700)\" stop-opacity=\"0.55\"></stop><stop offset=\"1\" stop-color=\"var(--color-accent-700)\" stop-opacity=\"0\"></stop></radialGradient></defs><rect width=\"400\" height=\"225\" fill=\"url(#bglenses)\"></rect><circle cx=\"300\" cy=\"60\" r=\"160\" fill=\"url(#gllenses)\"></circle><text x=\"200\" y=\"24\" text-anchor=\"middle\" style=\"font-family: var(--font-body); font-size: 8px; letter-spacing: 0.08em; fill: var(--color-accent-300); font-weight: 400;\">SQL ON THE TOPIC · NO CLI</text><rect x=\"20\" y=\"40\" width=\"360\" height=\"160\" rx=\"8\" fill=\"var(--color-neutral-800)\" stroke=\"var(--color-neutral-600)\" stroke-width=\"1\" stroke-dasharray=\"none\" opacity=\"1\"></rect><path d=\"M20 60 L380 60\" fill=\"none\" stroke=\"var(--color-neutral-600)\" stroke-width=\"1\" stroke-dasharray=\"none\" opacity=\"1\" stroke-linecap=\"round\"></path><circle cx=\"34\" cy=\"50\" r=\"3\" fill=\"var(--color-neutral-600)\"></circle><circle cx=\"44\" cy=\"50\" r=\"3\" fill=\"var(--color-neutral-600)\"></circle><circle cx=\"54\" cy=\"50\" r=\"3\" fill=\"var(--color-neutral-600)\"></circle><rect x=\"34\" y=\"70\" width=\"332\" height=\"24\" rx=\"4\" fill=\"var(--color-bg)\" stroke=\"var(--color-accent-500)\" stroke-width=\"1\" stroke-dasharray=\"none\" opacity=\"1\"></rect><text x=\"44\" y=\"86\" text-anchor=\"start\" style=\"font-family: var(--font-body); font-size: 8px; letter-spacing: 0.08em; fill: var(--color-accent-100); font-weight: 400;\">SELECT * FROM vessels WHERE speed &gt; 20</text><rect x=\"300\" y=\"76\" width=\"1.5\" height=\"12\" fill=\"var(--color-accent-100)\" style=\"animation: 1s steps(2) 0s infinite normal none running ring;\"></rect><path d=\"M34 120 L366 120\" fill=\"none\" stroke=\"var(--color-neutral-700)\" stroke-width=\"1\" stroke-dasharray=\"none\" opacity=\"1\" stroke-linecap=\"round\"></path><rect x=\"36\" y=\"108\" width=\"48\" height=\"8\" rx=\"2\" fill=\"var(--color-neutral-700)\" stroke=\"none\" stroke-width=\"1\" stroke-dasharray=\"none\" opacity=\"1\"></rect><rect x=\"126\" y=\"108\" width=\"43\" height=\"8\" rx=\"2\" fill=\"var(--color-neutral-700)\" stroke=\"none\" stroke-width=\"1\" stroke-dasharray=\"none\" opacity=\"1\"></rect><rect x=\"216\" y=\"108\" width=\"38\" height=\"8\" rx=\"2\" fill=\"var(--color-neutral-700)\" stroke=\"none\" stroke-width=\"1\" stroke-dasharray=\"none\" opacity=\"1\"></rect><rect x=\"296\" y=\"108\" width=\"33\" height=\"8\" rx=\"2\" fill=\"var(--color-neutral-700)\" stroke=\"none\" stroke-width=\"1\" stroke-dasharray=\"none\" opacity=\"1\"></rect><path d=\"M34 140 L366 140\" fill=\"none\" stroke=\"var(--color-neutral-700)\" stroke-width=\"1\" stroke-dasharray=\"none\" opacity=\"1\" stroke-linecap=\"round\"></path><rect x=\"36\" y=\"128\" width=\"41\" height=\"8\" rx=\"2\" fill=\"var(--color-accent-700)\" stroke=\"none\" stroke-width=\"1\" stroke-dasharray=\"none\" opacity=\"1\"></rect><rect x=\"126\" y=\"128\" width=\"36\" height=\"8\" rx=\"2\" fill=\"var(--color-accent-700)\" stroke=\"none\" stroke-width=\"1\" stroke-dasharray=\"none\" opacity=\"1\"></rect><rect x=\"216\" y=\"128\" width=\"31\" height=\"8\" rx=\"2\" fill=\"var(--color-accent-700)\" stroke=\"none\" stroke-width=\"1\" stroke-dasharray=\"none\" opacity=\"1\"></rect><rect x=\"296\" y=\"128\" width=\"44\" height=\"8\" rx=\"2\" fill=\"var(--color-accent-700)\" stroke=\"none\" stroke-width=\"1\" stroke-dasharray=\"none\" opacity=\"1\"></rect><path d=\"M34 160 L366 160\" fill=\"none\" stroke=\"var(--color-neutral-700)\" stroke-width=\"1\" stroke-dasharray=\"none\" opacity=\"1\" stroke-linecap=\"round\"></path><rect x=\"36\" y=\"148\" width=\"34\" height=\"8\" rx=\"2\" fill=\"var(--color-neutral-700)\" stroke=\"none\" stroke-width=\"1\" stroke-dasharray=\"none\" opacity=\"1\"></rect><rect x=\"126\" y=\"148\" width=\"47\" height=\"8\" rx=\"2\" fill=\"var(--color-neutral-700)\" stroke=\"none\" stroke-width=\"1\" stroke-dasharray=\"none\" opacity=\"1\"></rect><rect x=\"216\" y=\"148\" width=\"42\" height=\"8\" rx=\"2\" fill=\"var(--color-neutral-700)\" stroke=\"none\" stroke-width=\"1\" stroke-dasharray=\"none\" opacity=\"1\"></rect><rect x=\"296\" y=\"148\" width=\"37\" height=\"8\" rx=\"2\" fill=\"var(--color-neutral-700)\" stroke=\"none\" stroke-width=\"1\" stroke-dasharray=\"none\" opacity=\"1\"></rect><path d=\"M34 180 L366 180\" fill=\"none\" stroke=\"var(--color-neutral-700)\" stroke-width=\"1\" stroke-dasharray=\"none\" opacity=\"1\" stroke-linecap=\"round\"></path><rect x=\"36\" y=\"168\" width=\"45\" height=\"8\" rx=\"2\" fill=\"var(--color-neutral-700)\" stroke=\"none\" stroke-width=\"1\" stroke-dasharray=\"none\" opacity=\"1\"></rect><rect x=\"126\" y=\"168\" width=\"40\" height=\"8\" rx=\"2\" fill=\"var(--color-neutral-700)\" stroke=\"none\" stroke-width=\"1\" stroke-dasharray=\"none\" opacity=\"1\"></rect><rect x=\"216\" y=\"168\" width=\"35\" height=\"8\" rx=\"2\" fill=\"var(--color-neutral-700)\" stroke=\"none\" stroke-width=\"1\" stroke-dasharray=\"none\" opacity=\"1\"></rect><rect x=\"296\" y=\"168\" width=\"48\" height=\"8\" rx=\"2\" fill=\"var(--color-neutral-700)\" stroke=\"none\" stroke-width=\"1\" stroke-dasharray=\"none\" opacity=\"1\"></rect><circle cx=\"360\" cy=\"128\" r=\"4\" fill=\"none\" stroke=\"var(--color-accent-500)\" stroke-width=\"1\" style=\"transform-box: fill-box; transform-origin: center center; animation: 2s ease-out 0s infinite normal none running ring;\"></circle><circle cx=\"360\" cy=\"128\" r=\"4\" fill=\"var(--color-accent-100)\"></circle></svg></div><div data-dc-tpl=\"41\" style=\"display: grid; grid-template-columns: minmax(0px, 1fr); gap: 40px; max-width: 720px;\"><section data-dc-tpl=\"42\" style=\"display: flex; flex-direction: column; gap: 14px;\"><h2 data-dc-tpl=\"43\" style=\"margin: 0px; font-weight: 500; font-size: 22px; line-height: 30px; letter-spacing: -0.01em;\">Context</h2><p data-dc-tpl=\"44\" style=\"margin: 0px; font-size: 17px; line-height: 28px; color: var(--color-neutral-100);\">Vortexa is an energy analytics provider that tracks seaborne oil and gas worldwide. Its products depend on vessel position data and other sources processed in real time.</p></section><section data-dc-tpl=\"45\" style=\"display: flex; flex-direction: column; gap: 14px;\"><h2 data-dc-tpl=\"46\" style=\"margin: 0px; font-weight: 500; font-size: 22px; line-height: 30px; letter-spacing: -0.01em;\">The problem</h2><p data-dc-tpl=\"47\" style=\"margin: 0px; font-size: 17px; line-height: 28px; color: var(--color-neutral-100);\">The team chose Amazon MSK as managed Kafka, but the infrastructure remained a black box for developers. Everyday tasks, such as inspecting messages on a topic, understanding a topic’s profile or checking the replication factor, took commands and time.</p></section><section data-dc-tpl=\"48\" style=\"display: flex; flex-direction: column; gap: 14px;\"><h2 data-dc-tpl=\"49\" style=\"margin: 0px; font-weight: 500; font-size: 22px; line-height: 30px; letter-spacing: -0.01em;\">The solution</h2><p data-dc-tpl=\"50\" style=\"margin: 0px; font-size: 17px; line-height: 28px; color: var(--color-neutral-100);\">Vortexa adopted Lenses as its data operations portal on MSK and Kubernetes, with observability and governance control for real-time applications. Engineering and operations now use Lenses to understand the Kafka environment, and quality control on vessel signals is done there.</p></section><section data-dc-tpl=\"51\" style=\"display: flex; flex-direction: column; gap: 14px;\"><h2 data-dc-tpl=\"52\" style=\"margin: 0px; font-weight: 500; font-size: 22px; line-height: 30px; letter-spacing: -0.01em;\">Results</h2><p data-dc-tpl=\"53\" style=\"margin: 0px; font-size: 17px; line-height: 28px; color: var(--color-neutral-100);\">According to Lenses.io, Vortexa saved 15% of the working hours spent on Kafka management, moved to production deploys in minutes instead of days, increased Kafka users by 200% and cut AIS signal noise by 90% with quality control done in Lenses.</p></section><section data-dc-tpl=\"54\" style=\"display: flex; flex-direction: column; gap: 14px;\"><h2 data-dc-tpl=\"55\" style=\"margin: 0px; font-weight: 500; font-size: 22px; line-height: 30px; letter-spacing: -0.01em;\">What this means for your team</h2><p data-dc-tpl=\"56\" style=\"margin: 0px; font-size: 17px; line-height: 28px; color: var(--color-neutral-100);\">Managed Kafka solves infrastructure, not developer experience. When inspecting a topic depends on a specialist, Kafka becomes a bottleneck. A developer experience layer with SQL on topics and per-team permissions is what lets the number of users grow without growing the platform team.</p></section><div data-dc-tpl=\"57\" style=\"display: flex; flex-direction: column; gap: 6px; padding-top: 24px; background: linear-gradient(to right,var(--color-neutral-700),transparent) top/100% 1px no-repeat;\"><span data-dc-tpl=\"58\" style=\"font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-neutral-400);\">Source</span><a data-dc-tpl=\"59\" href=\"https://lenses.io/customers/vortexa\" target=\"_blank\" rel=\"noopener\" style=\"font-size: 14px; word-break: break-all;\">lenses.io/customers/vortexa ↗</a><span data-dc-tpl=\"60\" style=\"font-size: 13px; line-height: 20px; color: var(--color-neutral-400);\">Public case documented by Lenses.io. Summary and reading by Intelium.</span></div><div data-dc-tpl=\"61\" class=\"card\" style=\"display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px;\"><span data-dc-tpl=\"62\" style=\"font-size: 16px; font-weight: 500;\">Want to apply this in your context?</span><a data-dc-tpl=\"63\" href=\"../../../en/contact/\" class=\"btn btn-primary\">Talk to the CoE →</a></div></div><section data-dc-tpl=\"64\" style=\"display: flex; flex-direction: column; gap: 20px; padding-top: 40px; background: linear-gradient(to right,transparent,var(--color-neutral-700) 48px calc(100% - 48px),transparent) top/100% 1px no-repeat;\"><span data-dc-tpl=\"65\" style=\"font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-accent);\">More use cases</span><div data-dc-tpl=\"66\" style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, max(clamp(33.33% - 11px, -99900% + 959040px, 50% - 8px), -99900% + 519480px)), 1fr)); gap: 16px;\"><a data-dc-tpl=\"68\" href=\"../../../en/blog/viseca/\" class=\"scp1\" style=\"display: flex; flex-direction: column; border-radius: var(--radius-lg); background: var(--color-surface); box-shadow: var(--shadow-sm); color: var(--color-text); overflow: hidden; transition: transform 0.3s, box-shadow 0.3s;\"><div data-dc-tp