ssets/ui/flag-br.svg)) center/contain no-repeat;\"></span></a><span data-dc-tpl=\"26\" title=\"English (US)\" style=\"display: flex; padding: 3px; border-radius: 5px; box-shadow: 0 0 0 1px var(--color-accent-500);\"><span data-dc-tpl=\"27\" role=\"img\" aria-label=\"English (US)\" style=\"display: block; width: 22px; height: 16px; background: var(--img-flag-us,url(../../../assets/ui/flag-us.svg)) center/contain no-repeat;\"></span></span></span></div></nav><header data-dc-tpl=\"28\" style=\"position: relative; overflow: hidden;\"><div data-dc-tpl=\"29\" style=\"position: absolute; right: -200px; top: -260px; width: 900px; height: 700px; border-radius: 50%; background: radial-gradient(closest-side,color-mix(in srgb,var(--color-accent-700) 55%,transparent),transparent); animation: 18s ease-in-out 0s infinite normal none running drift; will-change: transform; pointer-events: none;\"></div><div data-dc-tpl=\"30\" style=\"position: relative; max-width: 1200px; margin: 0px auto; padding: clamp(56px, 8vw, 96px) clamp(20px, 5vw, 72px) clamp(24px, 4vw, 40px); display: flex; flex-direction: column; gap: 20px;\"><a data-dc-tpl=\"31\" href=\"../../../en/blog/technical/\" style=\"font-size: 14px; animation: 1s cubic-bezier(0.2, 0.7, 0.2, 1) 0s 1 normal both running rise;\">← Technical articles</a><div data-dc-tpl=\"32\" style=\"display: flex; flex-wrap: wrap; gap: 8px; align-items: center; animation: 1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.05s 1 normal both running rise;\"><span data-dc-tpl=\"33\" class=\"tag tag-accent\">Governance</span><span data-dc-tpl=\"34\" class=\"tag tag-outline\">Lenses.io</span><span data-dc-tpl=\"35\" style=\"font-size: 12px; color: var(--color-neutral-400);\">7 min read</span></div><h1 data-dc-tpl=\"36\" style=\"margin: 0px 0px 0px -0.03em; font-weight: 500; font-size: clamp(30px, 4.4vw, 52px); line-height: 1.12; letter-spacing: -0.02em; max-width: 880px; animation: 1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.15s 1 normal both running rise;\">Governance and data access on Kafka in regulated environments</h1><p data-dc-tpl=\"37\" style=\"margin: 0px; font-size: clamp(16px, 1.6vw, 18px); line-height: 1.6; max-width: 720px; color: var(--color-neutral-200); animation: 1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.3s 1 normal both running rise;\">Masking, per-team permissions and an audit trail: how to open Kafka to more people without creating privacy risk.</p></div></header><article data-dc-tpl=\"38\" style=\"max-width: 1200px; margin: 0px auto; padding: 0px clamp(20px, 5vw, 72px) clamp(64px, 8vw, 104px); display: flex; flex-direction: column; gap: 40px;\"><div data-dc-tpl=\"39\" style=\"position: relative; width: 100%; max-width: 880px; aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); background: var(--color-neutral-800);\"><svg viewBox=\"0 0 400 225\" width=\"100%\" aria-hidden=\"true\" style=\"position: absolute; inset: 0px; display: block; width: 100%; height: 100%;\"><defs><linearGradient id=\"gbars49\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0\" stop-color=\"var(--color-accent-900)\"></stop><stop offset=\"1\" stop-color=\"var(--color-neutral-800)\"></stop></linearGradient></defs><rect width=\"400\" height=\"225\" fill=\"url(#gbars49)\"></rect><rect x=\"20\" y=\"86.35000000000001\" width=\"14\" height=\"118.64999999999999\" rx=\"2\" fill=\"var(--color-accent-700)\" opacity=\"0.8235999999999999\"></rect><rect x=\"43\" y=\"147.7\" width=\"14\" height=\"57.3\" rx=\"2\" fill=\"var(--color-accent-700)\" opacity=\"0.7\"></rect><rect x=\"66\" y=\"59.05000000000001\" width=\"14\" height=\"145.95\" rx=\"2\" fill=\"var(--color-accent-700)\" opacity=\"0.8775999999999999\"></rect><rect x=\"89\" y=\"120.4\" width=\"14\" height=\"84.6\" rx=\"2\" fill=\"var(--color-accent-500)\" opacity=\"0.7552\"></rect><rect x=\"112\" y=\"31.75\" width=\"14\" height=\"173.25\" rx=\"2\" fill=\"var(--color-accent-700)\" opacity=\"0.9328\"></rect><rect x=\"135\" y=\"93.1\" width=\"14\" height=\"111.9\" rx=\"2\" fill=\"var(--color-accent-700)\" opacity=\"0.8104\"></rect><rect x=\"158\" y=\"154.45\" width=\"14\" height=\"50.55\" rx=\"2\" fill=\"var(--color-accent-700)\" opacity=\"0.9867999999999999\"></rect><rect x=\"181\" y=\"65.80000000000001\" width=\"14\" height=\"139.2\" rx=\"2\" fill=\"var(--color-accent-500)\" opacity=\"0.8644\"></rect><rect x=\"204\" y=\"127\" width=\"14\" height=\"78\" rx=\"2\" fill=\"var(--color-accent-700)\" opacity=\"0.742\"></rect><rect x=\"227\" y=\"38.5\" width=\"14\" height=\"166.5\" rx=\"2\" fill=\"var(--color-accent-700)\" opacity=\"0.9183999999999999\"></rect><rect x=\"250\" y=\"100\" width=\"14\" height=\"105\" rx=\"2\" fill=\"var(--color-accent-700)\" opacity=\"0.7959999999999999\"></rect><rect x=\"273\" y=\"161.2\" width=\"14\" height=\"43.8\" rx=\"2\" fill=\"var(--color-accent-500)\" opacity=\"0.9736\"></rect><rect x=\"296\" y=\"72.39999999999998\" width=\"14\" height=\"132.60000000000002\" rx=\"2\" fill=\"var(--color-accent-700)\" opacity=\"0.8512\"></rect><rect x=\"319\" y=\"133.9\" width=\"14\" height=\"71.1\" rx=\"2\" fill=\"var(--color-accent-700)\" opacity=\"0.7288\"></rect><rect x=\"342\" y=\"45.400000000000006\" width=\"14\" height=\"159.6\" rx=\"2\" fill=\"var(--color-accent-700)\" opacity=\"0.9063999999999999\"></rect><rect x=\"365\" y=\"106.6\" width=\"14\" height=\"98.4\" rx=\"2\" fill=\"var(--color-accent-500)\" opacity=\"0.7839999999999999\"></rect></svg></div><div data-dc-tpl=\"40\" style=\"display: grid; grid-template-columns: minmax(0px, 1fr); gap: 40px; max-width: 720px;\"><section data-dc-tpl=\"41\" style=\"display: flex; flex-direction: column; gap: 14px;\"><h2 data-dc-tpl=\"42\" style=\"margin: 0px; font-weight: 500; font-size: 22px; line-height: 30px; letter-spacing: -0.01em;\">The dilemma</h2><p data-dc-tpl=\"43\" style=\"margin: 0px; font-size: 17px; line-height: 28px; color: var(--color-neutral-100);\">The more teams use Kafka, the more value it creates, and the more personal data flows in front of more eyes. In banking, insurance and healthcare, the usual answer is to restrict access to a few specialists, which turns Kafka into a bottleneck.</p></section><section data-dc-tpl=\"44\" style=\"display: flex; flex-direction: column; gap: 14px;\"><h2 data-dc-tpl=\"45\" style=\"margin: 0px; font-weight: 500; font-size: 22px; line-height: 30px; letter-spacing: -0.01em;\">Three controls that solve most of it</h2><p data-dc-tpl=\"46\" style=\"margin: 0px; font-size: 17px; line-height: 28px; color: var(--color-neutral-100);\">Permissions per team and per topic namespace, so each squad accesses only its domain. Masking of sensitive fields in views, so a developer can debug a flow without seeing tax IDs, emails or health data. And an audit trail of who queried, changed or created resources in Kafka.</p><p data-dc-tpl=\"47\" style=\"margin: 0px; font-size: 17px; line-height: 28px; color: var(--color-neutral-100);\">Lenses offers all three in a single layer, on top of any Kafka cluster.</p></section><section data-dc-tpl=\"48\" style=\"display: flex; flex-direction: column; gap: 14px;\"><h2 data-dc-tpl=\"49\" style=\"margin: 0px; font-weight: 500; font-size: 22px; line-height: 30px; letter-spacing: -0.01em;\">Where this fits in privacy regulation</h2><p data-dc-tpl=\"50\" style=\"margin: 0px; font-size: 17px; line-height: 28px; color: var(--color-neutral-100);\">Privacy laws such as GDPR and Brazil’s LGPD require personal data processing to be limited to what is necessary and the company to demonstrate the security measures it takes. Least-privilege access per team, masking and auditing are technical measures that help meet those principles and answer a data subject or regulator request.</p><p data-dc-tpl=\"51\" style=\"margin: 0px; font-size: 17px; line-height: 28px; color: var(--color-neutral-100);\">This does not replace legal and privacy work, but it gives it concrete evidence of what happens in Kafka.</p></section><section data-dc-tpl=\"52\" style=\"display: flex; flex-direction: column; gap: 14px;\"><h2 data-dc-tpl=\"53\" style=\"margin: 0px; font-weight: 500; font-size: 22px; line-height: 30px; letter-spacing: -0.01em;\">How to implement</h2><p data-dc-tpl=\"54\" style=\"margin: 0px; font-size: 17px; line-height: 28px; color: var(--color-neutral-100);\">Start by classifying topics: which carry personal data and which fields. Define masking policies from that classification, not topic by topic. Integrate Lenses groups with the company identity provider so an employee leaving revokes access automatically.</p></section><section data-dc-tpl=\"55\" style=\"display: flex; flex-direction: column; gap: 14px;\"><h2 data-dc-tpl=\"56\" style=\"margin: 0px; font-weight: 500; font-size: 22px; line-height: 30px; letter-spacing: -0.01em;\">Common pitfalls</h2><p data-dc-tpl=\"57\" style=\"margin: 0px; font-size: 17px; line-height: 28px; color: var(--color-neutral-100);\">Masking only in the tool and leaving direct consumption uncontrolled is the most common failure: the policy must also hold in the cluster ACLs. Another is classifying once and forgetting; new fields appear with every schema evolution, and classification has to keep up.</p></section><div data-dc-tpl=\"58\" style=\"display: flex; flex-direction: column; gap: 6px; padding-top: 24px; background: linear-gradient(to right,var(--color-neutral-700),transparent) top/100% 1px no-repeat;\"><span data-dc-tpl=\"59\" style=\"font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-neutral-400);\">References</span><a data-dc-tpl=\"60\" href=\"https://docs.lenses.io/\" target=\"_blank\" rel=\"noopener\" style=\"font-size: 14px; word-break: break-all;\">docs.lenses.io ↗</a><a data-dc-tpl=\"61\" href=\"https://www.gov.br/anpd/\" target=\"_blank\" rel=\"noopener\" style=\"font-size: 14px; word-break: break-all;\">www.gov.br/anpd ↗</a><span data-dc-tpl=\"62\" style=\"font-size: 13px; line-height: 20px; color: var(--color-neutral-400);\">Technical article by Intelium.</span></div><div data-dc-tpl=\"63\" class=\"card\" style=\"display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px;\"><span data-dc-tpl=\"64\" style=\"font-size: 16px; font-weight: 500;\">Want to apply this in your context?</span><a data-dc-tpl=\"65\" href=\"../../../en/contact/\" class=\"btn btn-primary\">Talk to the CoE →</a></div></div><section data-dc-tpl=\"66\" style=\"display: flex; flex-direction: column; gap: 20px; padding-top: 40px; background: linear-gradient(to right,transparent,var(--color-neutral-700) 48px calc(100% - 48px),transparent) top/100% 1px no-repeat;\"><span data-dc-tpl=\"67\" style=\"font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-accent);\">More articles</span><div data-dc-tpl=\"68\" style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, max(clamp(33.33% - 11px, -99900% + 959040px, 50% - 8px), -99900% + 519480px)), 1fr)); gap: 16px;\"><a data-dc-tpl=\"70\" href=\"../../../en/blog/lenses-multicluster/\" class=\"scp1\" style=\"display: flex; flex-direction: column; border-radius: var(--radius-lg); background: var(--color-surface); box-shadow: var(--shadow-sm); color: var(--color-text); overflow: hidden; transition: transform 0.3s, box-shadow 0.3s;\"><div data-dc-tpl=\"71\" style=\"position: relative; width: 100%; aspect-ratio: 16 / 9; overflow: hidden; background: var(--color-neutral-800);\"><svg viewBox=\"0 0 400 225\" width=\"100%\" aria-hidden=\"true\" style=\"position: absolute; inset: 0px; display: block; width: 100%; height: 100%;\"><defs><linearGradient id=\"gdots51\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0\" stop-color=\"var(--color-accent-900)\"></stop><stop offset=\"1\" stop-color=\"var(--color-neutral-800)\"></stop></linearGradient></defs><rect width=\"400\" height=\"225\" fill=\"url(#gdots51)\"></rect><circle cx=\"20\" cy=\"22\" r=\"2.7359999999999998\" fill=\"var(--color-accent-700)\" opacity=\"0.6545\"></circ