center/contain no-repeat;\"></span></a><span data-dc-tpl=\"26\" title=\"English (US)\" style=\"display: flex; padding: 3px; border-radius: 5px; box-shadow: 0 0 0 1px var(--color-accent-500);\"><span data-dc-tpl=\"27\" role=\"img\" aria-label=\"English (US)\" style=\"display: block; width: 22px; height: 16px; background: var(--img-flag-us,url(../../assets/ui/flag-us.svg)) center/contain no-repeat;\"></span></span></span></div></nav><div data-dc-tpl=\"28\" aria-hidden=\"true\" style=\"height: 56px;\"></div><header data-dc-tpl=\"29\" style=\"position: relative; overflow: hidden;\"><div data-dc-tpl=\"30\" style=\"position: absolute; right: -200px; top: -260px; width: 900px; height: 700px; border-radius: 50%; background: radial-gradient(closest-side,color-mix(in srgb,var(--color-accent-700) 55%,transparent),transparent); animation: 18s ease-in-out 0s infinite normal none running drift; will-change: transform; pointer-events: none;\"></div><div data-dc-tpl=\"31\" style=\"position: relative; max-width: 1200px; margin: 0px auto; padding: clamp(64px, 10vw, 120px) clamp(20px, 5vw, 72px) 0px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); align-items: end; gap: 24px 48px;\"><div data-dc-tpl=\"32\" style=\"display: flex; flex-direction: column; gap: 28px; padding-bottom: clamp(56px, 7vw, 88px);\"><span data-dc-tpl=\"33\" style=\"font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-accent); animation: 1s cubic-bezier(0.2, 0.7, 0.2, 1) 0s 1 normal both running rise;\">About Intelium</span><h1 data-dc-tpl=\"34\" style=\"margin: 0px 0px 0px -0.05em; font-weight: 500; font-size: clamp(36px, 6vw, 72px); line-height: 1.1; letter-spacing: -0.02em; max-width: 620px; animation: 1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.15s 1 normal both running rise;\">There is no AI without <span data-dc-tpl=\"35\" style=\"color: var(--color-accent-300);\">data in motion.</span></h1><p data-dc-tpl=\"36\" style=\"margin: 0px; font-size: clamp(16px, 1.6vw, 18px); line-height: 1.6; max-width: 640px; color: var(--color-neutral-200); animation: 1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.35s 1 normal both running rise;\">Intelium is The center of excellence in Data Streaming: specialists in Apache Kafka, Confluent and Real-Time AI. We build the streaming infrastructure that feeds predictive and generative models in real time.</p></div><div data-dc-tpl=\"37\" class=\"lighten\" style=\"align-self: end; animation: 1.2s cubic-bezier(0.2, 0.7, 0.2, 1) 0.5s 1 normal both running rise;\"><img data-dc-tpl=\"38\" src=\"../../assets/time-intelium.webp\" width=\"1300\" height=\"975\" fetchpriority=\"high\" decoding=\"async\" alt=\"Intelium team\" style=\"display: block; width: 100%; height: auto; max-width: 620px; margin-left: auto; mask-image: linear-gradient(rgb(0, 0, 0) 70%, transparent);\"></div></div></header><section data-dc-tpl=\"39\" aria-label=\"Structure\" style=\"background: radial-gradient(900px 420px at 85% -40%,color-mix(in srgb,var(--color-section-glow) 70%,transparent),transparent 64%),var(--color-section);\"><div data-dc-tpl=\"40\" style=\"max-width: 1200px; margin: 0px auto; padding: 56px clamp(20px, 5vw, 72px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 32px 24px;\"><div data-dc-tpl=\"41\"><p data-dc-tpl=\"42\" style=\"margin: 0px; font-size: clamp(32px, 3.4vw, 44px); line-height: 1.1; font-weight: 500;\">CoE</p><p data-dc-tpl=\"43\" style=\"margin: 12px 0px 0px; font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; color: color-mix(in srgb,var(--color-text) 70%,transparent);\">Center of Excellence in São Paulo</p></div><div data-dc-tpl=\"44\"><p data-dc-tpl=\"45\" style=\"margin: 0px; font-size: clamp(32px, 3.4vw, 44px); line-height: 1.1; font-weight: 500;\">100%</p><p data-dc-tpl=\"46\" style=\"margin: 12px 0px 0px; font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; color: color-mix(in srgb,var(--color-text) 70%,transparent);\">Of the team certified</p></div><div data-dc-tpl=\"47\"><p data-dc-tpl=\"48\" style=\"margin: 0px; font-size: clamp(32px, 3.4vw, 44px); line-height: 1.1; font-weight: 500;\">Global</p><p data-dc-tpl=\"49\" style=\"margin: 12px 0px 0px; font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; color: color-mix(in srgb,var(--color-text) 70%,transparent);\">Born global, headquartered in São Paulo</p></div></div></section><section data-dc-tpl=\"50\" aria-label=\"Industries\" style=\"max-width: 1200px; margin: 0px auto; padding: 28px clamp(20px, 5vw, 72px) 0px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px 32px;\"><span data-dc-tpl=\"51\" style=\"font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-neutral-400);\">We work in</span><div data-dc-tpl=\"52\" style=\"display: flex; flex-wrap: wrap; gap: 8px 28px; font-size: 16px; line-height: 24px; color: var(--color-neutral-100);\"><span data-dc-tpl=\"53\">Financial services</span><span data-dc-tpl=\"54\">Insurance</span><span data-dc-tpl=\"55\">Healthcare</span><span data-dc-tpl=\"56\">Retail</span><span data-dc-tpl=\"57\">Energy</span><span data-dc-tpl=\"58\">Public sector</span></div></section><section data-dc-tpl=\"59\" style=\"max-width: 1200px; margin: 0px auto; padding: clamp(64px, 8vw, 104px) clamp(20px, 5vw, 72px) 0px; display: flex; flex-wrap: wrap; gap: 32px 64px;\"><div data-dc-tpl=\"60\" style=\"flex: 1 1 300px; display: flex; flex-direction: column; gap: 14px;\"><span data-dc-tpl=\"61\" style=\"font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-accent);\">How we work</span><h2 data-dc-tpl=\"62\" style=\"margin: 0px; font-weight: 500; font-size: clamp(26px, 3vw, 36px); line-height: 1.2; letter-spacing: -0.015em;\">Forward Deployed Engineers</h2></div><div data-dc-tpl=\"63\" style=\"flex: 2 1 480px; display: flex; flex-direction: column; gap: 20px; min-width: 0px;\"><p data-dc-tpl=\"64\" style=\"margin: 0px; font-size: 17px; line-height: 28px; color: var(--color-neutral-200);\">Senior engineers work inside the client’s environment, embedded in the squad, in three phases: Full Immersion, Hands-on Execution and Knowledge Transfer. We leave behind built-in capability, not dependency.</p><a data-dc-tpl=\"65\" href=\"../../en/services/#fde\" style=\"font-size: 15px;\">See the FDE model →</a></div></section><section data-dc-tpl=\"66\" style=\"max-width: 1200px; margin: 0px auto; padding: clamp(64px, 8vw, 104px) clamp(20px, 5vw, 72px) 0px; display: flex; flex-wrap: wrap; gap: 32px 64px;\"><div data-dc-tpl=\"67\" style=\"flex: 1 1 300px; display: flex; flex-direction: column; gap: 14px;\"><span data-dc-tpl=\"68\" style=\"font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-accent);\">Community</span><h2 data-dc-tpl=\"69\" style=\"margin: 0px; font-weight: 500; font-size: clamp(26px, 3vw, 36px); line-height: 1.2; letter-spacing: -0.015em;\">Specialists who are also on stage.</h2></div><div data-dc-tpl=\"70\" style=\"flex: 2 1 480px; display: flex; flex-direction: column; gap: 20px; min-width: 0px;\"><p data-dc-tpl=\"71\" style=\"margin: 0px; font-size: 17px; line-height: 28px; color: var(--color-neutral-200);\">Our specialists speak on Data Streaming, drive local Apache Kafka communities and take part in programs such as Confluent Community Catalyst.</p><a data-dc-tpl=\"72\" href=\"../../en/events/\" style=\"font-size: 15px;\">See events →</a></div></section><section data-dc-tpl=\"73\" style=\"max-width: 1200px; margin: 0px auto; padding: clamp(64px, 8vw, 104px) clamp(20px, 5vw, 72px) 0px; display: flex; flex-direction: column; gap: 32px;\"><div data-dc-tpl=\"74\" style=\"display: flex; flex-direction: column; gap: 14px;\"><span data-dc-tpl=\"75\" style=\"font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-accent);\">Values</span><h2 data-dc-tpl=\"76\" style=\"margin: 0px; font-weight: 500; font-size: clamp(26px, 3vw, 36px); line-height: 1.2; letter-spacing: -0.015em;\">What guides every delivery.</h2></div><div data-dc-tpl=\"77\" style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, max(clamp(25% - 30px, -99900% + 879120px, 50% - 20px), -99900% + 439560px)), 1fr)); gap: 32px 40px;\"><div data-dc-tpl=\"78\" style=\"display: flex; flex-direction: column; gap: 10px; padding-top: 20px; background: linear-gradient(to right,var(--color-accent) 0 44px,var(--color-neutral-700) 44px) top/100% 1px no-repeat;\"><span data-dc-tpl=\"79\" style=\"font-size: 13px; color: var(--color-accent); font-feature-settings: &quot;tnum&quot;;\">01</span><h3 data-dc-tpl=\"80\" style=\"margin: 0px; font-weight: 500; font-size: 22px; line-height: 28px;\">Technical Excellence</h3></div><div data-dc-tpl=\"81\" style=\"display: flex; flex-direction: column; gap: 10px; padding-top: 20px; background: linear-gradient(to right,var(--color-accent) 0 44px,var(--color-neutral-700) 44px) top/100% 1px no-repeat;\"><span data-dc-tpl=\"82\" style=\"font-size: 13px; color: var(--color-accent); font-feature-settings: &quot;tnum&quot;;\">02</span><h3 data-dc-tpl=\"83\" style=\"margin: 0px; font-weight: 500; font-size: 22px; line-height: 28px;\">Radical Transparency</h3></div><div data-dc-tpl=\"84\" style=\"display: flex; flex-direction: column; gap: 10px; padding-top: 20px; background: linear-gradient(to right,var(--color-accent) 0 44px,var(--color-neutral-700) 44px) top/100% 1px no-repeat;\"><span data-dc-tpl=\"85\" style=\"font-size: 13px; color: var(--color-accent); font-feature-settings: &quot;tnum&quot;;\">03</span><h3 data-dc-tpl=\"86\" style=\"margin: 0px; font-weight: 500; font-size: 22px; line-height: 28px;\">Client Focus</h3></div><div data-dc-tpl=\"87\" style=\"display: flex; flex-direction: column; gap: 10px; padding-top: 20px; background: linear-gradient(to right,var(--color-accent) 0 44px,var(--color-neutral-700) 44px) top/100% 1px no-repeat;\"><span data-dc-tpl=\"88\" style=\"font-size: 13px; color: var(--color-accent); font-feature-settings: &quot;tnum&quot;;\">04</span><h3 data-dc-tpl=\"89\" style=\"margin: 0px; font-weight: 500; font-size: 22px; line-height: 28px;\">Continuous Learning</h3></div></div></section><section data-dc-tpl=\"90\" style=\"max-width: 1200px; margin: 0px auto; padding: clamp(64px, 8vw, 104px) clamp(20px, 5vw, 72px) 0px; display: flex; flex-direction: column; gap: 24px;\"><span data-dc-tpl=\"91\" style=\"font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-accent);\">Brands</span><div data-dc-tpl=\"92\" style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 16px;\"><div data-dc-tpl=\"93\" class=\"card scp1\" style=\"display: flex; flex-direction: column; gap: 10px; transition: transform 0.3s, box-shadow 0.3s;\"><span data-dc-tpl=\"94\" class=\"card-kicker\">Intelium Labs</span><h3 data-dc-tpl=\"95\" style=\"margin: 0px; font-weight: 500; font-size: 22px; line-height: 28px;\">Products and frameworks built by our team.</h3><p data-dc-tpl=\"96\" style=\"margin: 0px; font-size: 15px; line-height: 24px; color: var(--color-neutral-300);\">The IBM Event Streams → Confluent migration framework and Infra Forge, our automated builder of Confluent environments.</p><a data-dc-tpl=\"97\" href=\"../../en/labs/\" style=\"font-size: 14px; margin-top: auto; padding-top: 6px;\">See Labs →</a></div><div data-dc-tpl=\"98\" class=\"card scp1\" style=\"display: flex; flex-direction: column; gap: 10px; transition: transform 0.3s, box-shadow 0.3s;\"><span data-dc-tpl=\"99\" class=\"card-kicker\">Intelium Academy</span><h3 data-dc-tpl=\"100\" style=\"margin: 0px; font-weight: 500; font-size: 22px; line-height: 28px;\">Training the next generation of Data Streaming specialists.</h3><p data-dc-tpl=\"101\" style=\"margin: 0px; font-size: 15px; line-height: 24px; color: var(--color-neutral-300);\">Apache Kafka Fundamentals: 40h, online and in person.</p></div></div></section><section data-dc-tpl=\"102\" id=\"parceiros\" aria-label=\"Strategic partners\" style=\"max-width: 1200px; margin: 0px auto; padding: clamp(64px, 8vw, 104px) clamp(20px, 5vw, 72px); display: flex; flex-direction: column; gap: 32px; scroll-margin-top: 72px;\"><div data-dc-tpl=\"103\" style=\"display: flex; flex-direction: column; gap: 14px; max-width: 720px;\"><span data-dc-tpl=\"104\" style=\"font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-accent);\">Strategic partners</span><h2 data-dc-tpl=\"105\" style=\"margin: 0px; font-weight: 500; font-size: clamp(26px, 3vw, 36px); line-height: 1.2; letter-spacing: -0.015em;\">Each partner covers one layer of the problem.</h2><p data-dc-tpl=\"106\" style=\"margin: 0px; font-size: 16px; line-height: 26px; color: var(--color-neutral-200);\">We pick few partners and go deep on each one. What you see below is what we run in production, not a wall of logos.</p></div><div data-dc-tpl=\"107\" style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr)); gap: 16px;\"><div data-dc-tpl=\"108\" class=\"card\" style=\"display: flex; flex-direction: column; gap: 18px; padding: clamp(20px, 2.6vw, 28px);\"><div data-dc-tpl=\"109\" style=\"display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px;\"><div data-dc-tpl=\"110\" style=\"display: flex; align-items: center; gap: 16px;\"><img data-dc-tpl=\"111\" src=\"../../assets/parceiros/ibm.webp\" alt=\"IBM\" width=\"76\" height=\"28\" loading=\"lazy\" decoding=\"async\" style=\"display: block; height: 28px; width: auto;\"><span data-dc-tpl=\"112\" aria-hidden=\"true\" style=\"width: 1px; height: 20px; background: var(--color-neutral-600);\"></span><img data-dc-tpl=\"113\" src=\"../../assets/parceiros/confluent.webp\" alt=\"Confluent\" width=\"141\" height=\"28\" loading=\"lazy\" decoding=\"async\" style=\"display: block; height: 28px; width: auto;\"></div><span data-dc-tpl=\"114\" class=\"tag tag-accent\">IBM Partner · IBM Confluent specialists</span></div><div data-dc-tpl=\"115\" style=\"display: flex; flex-direction: column; gap: 6px;\"><span data-dc-tpl=\"116\" style=\"font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-neutral-400);\">Why it matters</span><p data-dc-tpl=\"117\" style=\"margin: 0px; font-size: 15px; line-height: 24px; color: var(--color-neutral-200);\">With IBM’s acquisition of Confluent, the data-in-motion platform and Brazil’s critical legacy ecosystem (MQ, mainframe, Cloud Pak, Event Streams) now sit under one roof. We are IBM partners specialized in IBM Confluent: managed Kafka, Flink, Schema Registry, Connect and Tableflow, in the cloud or on-prem.</p></div><div data-dc-tpl=\"118\" style=\"display: flex; flex-direction: column; gap: 8px;\"><span data-dc-tpl=\"119\" style=\"font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-neutral-400);\">What we do together</span><ul data-dc-tpl=\"120\" style=\"list-style: none; margin: 0px; padding: 0px; display: flex; flex-direction: column; gap: 8px;\"><li data-dc-tpl=\"121\" style=\"display: flex; gap: 12px; align-items: baseline; font-size: 14px; line-height: 22px; color: var(--color-neutral-100);\"><span data-dc-tpl=\"122\" style=\"flex: 0 0 auto; width: 14px; height: 1px; background: var(--color-accent); transform: translateY(-5px);\"></span>Deployment and operations of Confluent Cloud, Platform and Private Cloud</li><li data-dc-tpl=\"123\" style=\"display: flex; gap: 12px; align-items: baseline; font-size: 14px; line-height: 22px; color: var(--color-neutral-100);\"><span data-dc-tpl=\"124\" style=\"flex: 0 0 auto; width: 14px; height: 1px; background: var(--color-accent); transform: translateY(-5px);\"></span>Mainframe and MQ decoupling through CDC and events</li><li data-dc-tpl=\"125\" style=\"display: flex; gap: 12px; align-items: baseline; font-size: 14px; line-height: 22px; color: var(--color-neutral-100);\"><span data-dc-tpl=\"126\" style=\"flex: 0 0 auto; width: 14px; height: 1px; background: var(--color-accent); transform: translateY(-5px);\"></span>Our own Event Streams → Confluent migration framework</li><li data-dc-tpl=\"127\" style=\"display: flex; gap: 12px; align-items: baseline; font-size: 14px; line-height: 22px; color: var(--color-neutral-100);\"><span data-dc-tpl=\"128\" style=\"flex: 0 0 auto; width: 14px; height: 1px; background: var(--color-accent); transform: translateY(-5px);\"></span>Co-sell and events: Kafka Meetup SP, Data In Motion, IBM Think and Tech Summit</li></ul></div></div><div data-dc-tpl=\"129\" class=\"card\" style=\"display: flex; flex-direction: column; gap: 18px; padding: clamp(20px, 2.6vw, 28px);\"><div data-dc-tpl=\"130\" style=\"display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px;\"><img data-dc-tpl=\"131\" src=\"../../assets/parceiros/lenses.webp\" alt=\"Lenses.io\" width=\"107\" height=\"28\" loading=\"lazy\" decoding=\"async\" style=\"display: block; height: 28px; width: auto;\"><span data-dc-tpl=\"132\" class=\"tag tag-accent\">Developer Experience partner</span></div><div data-dc-tpl=\"133\" style=\"display: flex; flex-direction: column; gap: 6px;\"><span data-dc-tpl=\"134\" style=\"font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-neutral-400);\">Why it matters</span><p data-dc-tpl=\"135\" style=\"margin: 0px; font-size: 15px; line-height: 24px; color: var(--color-neutral-200);\">Lenses is the developer experience layer for Kafka: a single interface to explore topics, query data with SQL, catalog schemas and enforce governance (RBAC, auditing, masking) across many clusters at once, whether Confluent, MSK or open-source Kafka. It cuts the reliance on scripts and speeds up teams building on events.</p></div><div data-dc-tpl=\"136\" style=\"display: flex; flex-direction: column; gap: 8px;\"><span data-dc-tpl=\"137\" style=\"font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-neutral-400);\">What we do together</span><ul data-dc-tpl=\"138\" style=\"list-style: none; margin: 0px; padding: 0px; display: flex; flex-direction: column; gap: 8px;\"><li data-dc-tpl=\"139\" style=\"display: flex; gap: 12px; align-items: baseline; font-size: 14px; line-height: 22px; color: var(--color-neutral-100);\"><span data-dc-tpl=\"140\" style=\"flex: 0 0 auto; width: 14px; height: 1px; background: var(--color-accent); transform: translateY(-5px);\"></span>Cluster observability and troubleshooting with SQL Studio and alerts</li><li data-dc-tpl=\"141\" style=\"display: flex; gap: 12px; align-items: baseline; font-size: 14px; line-height: 22px; color: var(--color-neutral-100);\"><span data-dc-tpl=\"142\" style=\"flex: 0 0 auto; width: 14px; height: 1px; background: var(--color-accent); transform: translateY(-5px);\"></span>Governance: data catalog, RBAC, auditing and masking policies</li><li data-dc-tpl=\"143\" style=\"display: flex; gap: 12px; align-items: baseline; font-size: 14px; line-height: 22px; color: var(--color-neutral-100);\"><span data-dc-tpl=\"144\" style=\"flex: 0 0 auto; width: 14px; height: 1px; background: var(--color-accent); transform: translateY(-5px);\"></span>Multi-cluster operations with Lenses 6 and per-environment agents</li><li data-dc-tpl=\"145\" style=\"display: flex; gap: 12px; align-items: baseline; font-size: 14px; line-height: 22px; color: var(--color-neutral-100);\"><span data-dc-tpl=\"146\" style=\"flex: 0 0 auto; width: 14px; height: 1px; background: var(--color-accent); transform: translateY(-5px);\"></span>Enablement for development teams</li></ul></div></div></div></section><footer data-dc-tpl=\"147\" id=\"contato\" style=\"max-width: 1200px; margin: 0px auto; padding: 0px clamp(20px, 5vw, 72px);\"><div data-dc-tpl=\"148\" style=\"height: 1px; background: linear-gradient(to right,transparent,var(--color-divider) 48px calc(100% - 48px),transparent);\"></div><div data-dc-tpl=\"149\" style=\"padding: 56px 0px 48px; display: flex; justify-content: space-between; align-items: flex-start; gap: 40px 64px; flex-wrap: wrap;\"><div data-dc-tpl=\"150\" style=\"display: flex; flex-direction: column; gap: 12px; flex: 1 1 320px; max-width: 440px;\"><span data-dc-tpl=\"151\" style=\"font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-neutral-400);\">Newsletter</span><span data-dc-tpl=\"152\" style=\"font-size: 18px; font-weight: 500; line-height: 1.3;\">Intelium In Motion</span><span data-dc-tpl=\"153\" style=\"font-size: 14px; line-height: 22px; color: var(--color-neutral-300);\">Monthly: what changed in Confluent, Kafka and Flink, and what it means for teams running streaming in production.</span><form data-dc-tpl=\"154\" class=\"nl-form\" data-newsletter=\"\" action=\"#\"><div data-dc-tpl=\"155\" class=\"nl-fields\" style=\"gap: 8px; flex-wrap: wrap; flex: 1 1 100%;\"><input data-dc-tpl=\"156\" type=\"email\" class=\"input\" placeholder=\"you@company.com\" aria-label=\"E-mail\" style=\"flex: 1 1 200px; min-width: 0px;\"><label data-dc-tpl=\"157\" class=\"btn btn-primary\" style=\"cursor: pointer;\"><input data-dc-tpl=\"158\" type=\"checkbox\" class=\"nl-check\" style=\"position: absolute; opacity: 0; width: 0px; height: 0px;\">Subscribe</label></div><span data-dc-tpl=\"159\" class=\"nl-done\" style=\"align-items: center; gap: 8px; font-size: 14px; color: var(--color-accent-300);\">Thanks. You are on the list for the next issue.</span></form></div><div data-dc-tpl=\"160\" style=\"display: flex; flex-direction: column; gap: 14px;\"><span data-dc-tpl=\"161\" role=\"img\" aria-label=\"Intelium\" style=\"display: block; width: 40px; height: 40px; background: var(--img-isotipo,url(../../assets/ui/isotipo.png)) center/contain no-repeat;\"></span><span data-dc-tpl=\"162\" style=\"font-size: 14px; line-height: 22px; color: var(--color-neutral-300);\">CoE Intelium.ai</span></div><div data-dc-t