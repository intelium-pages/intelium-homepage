ius: 5px; box-shadow: 0 0 0 1px var(--color-accent-500);\"><span data-dc-tpl=\"27\" role=\"img\" aria-label=\"English (US)\" style=\"display: block; width: 22px; height: 16px; background: var(--img-flag-us,url(../../assets/ui/flag-us.svg)) center/contain no-repeat;\"></span></span></span></div></nav><div data-dc-tpl=\"28\" aria-hidden=\"true\" style=\"height: 56px;\"></div><header data-dc-tpl=\"29\" style=\"position: relative; overflow: hidden;\"><div data-dc-tpl=\"30\" style=\"position: absolute; right: -200px; top: -260px; width: 900px; height: 700px; border-radius: 50%; background: radial-gradient(closest-side,color-mix(in srgb,var(--color-accent-700) 55%,transparent),transparent); animation: 18s ease-in-out 0s infinite normal none running drift; will-change: transform; pointer-events: none;\"></div><div data-dc-tpl=\"31\" style=\"position: relative; max-width: 1200px; margin: 0px auto; padding: clamp(64px, 10vw, 120px) clamp(20px, 5vw, 72px) clamp(16px, 3vw, 32px); display: flex; flex-direction: column; gap: 28px;\"><span data-dc-tpl=\"32\" style=\"font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-accent); animation: 1s cubic-bezier(0.2, 0.7, 0.2, 1) 0s 1 normal both running rise;\">Intelium Labs · Our accelerators</span><h1 data-dc-tpl=\"33\" style=\"margin: 0px 0px 0px -0.05em; font-weight: 500; font-size: clamp(36px, 6vw, 72px); line-height: 1.1; letter-spacing: -0.02em; max-width: 980px; animation: 1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.15s 1 normal both running rise;\">Proprietary methods that cut <span data-dc-tpl=\"34\" style=\"color: var(--color-accent-300);\">risk and time.</span></h1></div></header><section data-dc-tpl=\"35\" style=\"max-width: 1200px; margin: 0px auto; padding: clamp(56px, 7vw, 88px) clamp(20px, 5vw, 72px) 0px;\"><div data-dc-tpl=\"36\" style=\"display: flex; flex-direction: column; gap: 36px; padding-top: 40px; background: linear-gradient(to right,transparent,var(--color-neutral-700) 48px calc(100% -