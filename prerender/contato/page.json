div data-dc-tpl=\"37\" style=\"display: flex; flex-wrap: wrap; gap: 40px 64px; align-items: flex-start;\"><form data-dc-tpl=\"38\" style=\"position: relative; flex: 2 1 420px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 20px;\"><div data-dc-tpl=\"39\" class=\"field\"><label data-dc-tpl=\"40\" for=\"f-nome\">Nome</label><input data-dc-tpl=\"41\" id=\"f-nome\" name=\"nome\" class=\"input\" type=\"text\" autocomplete=\"name\" required=\"\" minlength=\"2\" maxlength=\"120\"></div><div data-dc-tpl=\"42\" class=\"field\"><label data-dc-tpl=\"43\" for=\"f-email\">E-mail corporativo</label><input data-dc-tpl=\"44\" id=\"f-email\" name=\"email\" data-corporate=\"true\" class=\"input\" type=\"email\" autocomplete=\"email\" required=\"\" maxlength=\"200\"></div><div data-dc-tpl=\"45\" class=\"field\"><label data-dc-tpl=\"46\" for=\"f-empresa\">Empresa</label><input data-dc-tpl=\"47\" id=\"f-empresa\" name=\"empresa\" class=\"input\" type=\"text\" autocomplete=\"organization\" maxlength=\"160\"></div><div data-dc-tpl=\"48\" class=\"field\"><label data-dc-tpl=\"49\" for=\"f-cargo\">Cargo</label><input data-dc-tpl=\"50\" id=\"f-cargo\" name=\"cargo\" class=\"input\" type=\"text\" autocomplete=\"organization-title\" maxlength=\"120\"></div><div data-dc-tpl=\"51\" class=\"field\" style=\"grid-column: 1 / -1;\"><label data-dc-tpl=\"52\" for=\"f-assunto\">Assunto</label><select data-dc-tpl=\"53\" id=\"f-assunto\" class=\"input\"><option data-dc-tpl=\"54\" value=\"foundation\">Streaming Foundation</option><option data-dc-tpl=\"55\" value=\"fde\">Squad FDE · Forward Deployed Engineer</option><option data-dc-tpl=\"56\" value=\"assessment\">Assessment / Health Check</option><option data-dc-tpl=\"57\" value=\"legacy\">Legacy Modernization</option><option data-dc-tpl=\"58\" value=\"ai\">Real-Time AI/ML</option><option data-dc-tpl=\"59\" value=\"bolsa\">Bolsa de Especialistas</option><option data-dc-tpl=\"60\" value=\"convite\">Eventos · convi